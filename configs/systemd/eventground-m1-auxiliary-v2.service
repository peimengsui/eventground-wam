[Unit]
ConditionPathExists=!/home/peimengsui/data/eventground-wam/libero-plus/training/week7-m1-auxiliary-v2/training-report.json
Description=EventGround Week 7 M1 Pixel auxiliary policy, fixed two epochs
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/peimengsui/code/eventground-wam-m1-auxiliary-v2
Environment=PYTHONPATH=/home/peimengsui/code/eventground-wam-m1-auxiliary-v2/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
ExecStart=/home/peimengsui/code/eventground-wam-b0-oft-v1/environments/b0/.venv/bin/python /home/peimengsui/code/eventground-wam-m1-auxiliary-v2/scripts/train_auxiliary_policy.py --recipe /home/peimengsui/code/eventground-wam-m1-auxiliary-v2/configs/training/week7_m1_auxiliary_v1.json --output /home/peimengsui/data/eventground-wam/libero-plus/training/week7-m1-auxiliary-v2
StandardOutput=append:/home/peimengsui/data/eventground-wam/libero-plus/training/week7-m1-auxiliary-v2/service.log
StandardError=append:/home/peimengsui/data/eventground-wam/libero-plus/training/week7-m1-auxiliary-v2/service.log
Restart=on-failure
RestartPreventExitStatus=1 75 78
RestartSec=60
TimeoutStartSec=0
TimeoutStopSec=180
RuntimeMaxSec=193h
KillMode=mixed
OOMPolicy=stop
CPUQuota=600%
MemoryMax=28G
UMask=0077

[Install]
WantedBy=default.target
