[Unit]
Description=EventGround M3 Feifei coupled pixel policy, fixed two epochs
ConditionPathExists=!/home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-coupled-v1/training-report.json
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/peimengsui/code/eventground-wam-m3-coupled-v1
Environment=PYTHONPATH=/home/peimengsui/code/eventground-wam-m3-coupled-v1/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1
Environment=CUBLAS_WORKSPACE_CONFIG=:4096:8
Environment=PYTORCH_ALLOC_CONF=expandable_segments:True
UnsetEnvironment=PYTORCH_CUDA_ALLOC_CONF
ExecStart=/home/peimengsui/code/eventground-wam-week4-run-v2/environments/b0/.venv/bin/python /home/peimengsui/code/eventground-wam-m3-coupled-v1/scripts/train_coupled_policy.py --arm M3 --qualification /home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-feifei-qualification-v1/attempt-02/run --profile /home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-feifei-qualification-v1/attempt-02/runtime.json --output /home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-coupled-v1
StandardOutput=append:/home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-coupled-v1/service.log
StandardError=append:/home/peimengsui/data/eventground-wam/libero-plus/training/week8-m3-coupled-v1/service.log
Restart=on-failure
RestartPreventExitStatus=1 75 78
RestartSec=60
TimeoutStartSec=0
TimeoutStopSec=180
RuntimeMaxSec=193h
KillMode=mixed
OOMPolicy=stop
CPUQuota=600%
MemoryMax=28G
UMask=0077

[Install]
WantedBy=default.target
