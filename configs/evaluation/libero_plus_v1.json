    "dev-210": {
      "task_count": 210,
      "rule": "six_labeled_tasks_per_category_x_difficulty_cell"
    },
    "stratified-1K": {
      "task_count": 1000,
      "rule": "proportional_category_x_difficulty_x_suite_with_unlabeled_preserved"
