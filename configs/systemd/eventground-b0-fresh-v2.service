[Unit]
Description=EventGround fresh all-L1 two epochs and frozen clean/dev evaluations
StartLimitIntervalSec=3600
StartLimitBurst=4

[Service]
Type=oneshot
WorkingDirectory=/home/peimengsui/data/eventground-wam/libero-plus/derived/b0/week4-fresh-all-l1-v2
ExecStart=/home/peimengsui/code/eventground-wam-fresh-v2/scripts/run_b0_fresh.sh pipeline /home/peimengsui/data/eventground-wam/libero-plus/derived/b0/week4-fresh-all-l1-v2
RemainAfterExit=yes
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
TimeoutStartSec=0
TimeoutStopSec=180
KillMode=mixed
OOMPolicy=stop

[Install]
WantedBy=default.target
